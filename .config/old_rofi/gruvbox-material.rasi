// gruvbox theme

* {
  // Base Gruvbox Material palette refined for better contrast on semi-transparent bg
  gruv0:        #1d2021; // hard bg
  gruv1:        #282828; // normal bg
  gruv2:        #32302f;
  gruv3:        #3c3836;
  gruv4:        #504945; // mid shadow
  gruv5:        #665c54; // muted fg
  gruv6:        #7c6f64; // neutral
  gruv7:        #bdae93; // fg alt
  gruv8:        #d5c4a1; // fg soft
  gruv9:        #ebdbb2; // main light fg
  gruv10:       #fbf1c7; // brightest

  red:          #fb4934;
  orange:       #fe8019;
  yellow:       #fabd2f;
  aqua:         #8ec07c;
  blue:         #83a598;
  purple:       #d3869b;
  green:        #b8bb26;

  reddark:      #cc241d;
  yellowdark:   #d79921;
  transparent:  rgba(24, 22, 20, 0.88);

  // Semantic aliases
  foreground:   @gruv9;
  accent:       @yellow;
  danger:       @red;
  warning:      @yellow;
  info:         @blue;
  success:      @green;

  background-color: transparent;
  // Rofi highlight only accepts style tokens (underline/bold/italic); color reference caused parse error
  highlight: underline bold;

  // (removed spacing-* variables to avoid hyphen parsing issues)
}

window {
  location:        center;
  anchor:          center;
  border-radius:   6px;
  border:          2px;
  border-color:    @gruv4;
  padding:         6px 6px 10px 6px;
  width:           640px;
  height:          560px;
  background-color: @transparent;
  spacing:         0;
  children:        [mainbox];
  orientation:     horizontal;
}

mainbox {
  spacing: 0;
  children: [inputbar, message, listview];
}

message {
  padding: 10px;
  border: 0px 2px 2px 2px;
  border-color: @gruv0;
  background-color: @transparent;
}

inputbar {
  color:            @gruv10;
  padding:          14px;
  background-color: rgba(40,40,40,0.35);
  border-color:     @aqua;
  border:           2px;
  border-radius:    4px;
  margin:           0 0 8px 0;
  text-color:       @gruv10;
  font:             "JetBrainsMono Nerd Font 13";
}

entry,
prompt,
case-indicator {
  text-font: inherit;
  text-color: inherit;
}

prompt {
  margin: 0px 1em 0em 0em;
}

listview {
  padding:          8px;
  border-radius:    4px;
  border:           0px 0px 0px 0px;
  background-color: rgba(29,32,33,0.55);
  dynamic:          false;
  lines:            12;
  columns:          1;
  scrollbar:        true;
  scrollbar-width:  4px;
  scrollbar-color:  @accent;
}

element {
  padding:          6px 8px;
  vertical-align:   0.5;
  border-radius:    4px;
  color:            @foreground;
  text-color:       @gruv9;
  background-color: transparent;
  spacing:          6px;
  font:             "JetBrainsMono Nerd Font 12";
  border:           0px 0px 1px 0px;
  border-color:     rgba(255,255,255,0.05);
}

element.normal.active {
  background-color: rgba(250,189,47,0.18);
  text-color: @accent;
}

element.normal.urgent {
  background-color: rgba(204,36,29,0.25);
  text-color: @danger;
}

element.selected.normal {
  background-color: rgba(254,128,25,0.32);
  text-color: @gruv10;
  border: 0px;
}

element.selected.active {
  background-color: rgba(142,192,124,0.35);
  text-color: @gruv10;
}

element.selected.urgent {
  background-color: rgba(204,36,29,0.55);
  text-color: @gruv10;
}

element.alternate.normal {
  background-color: rgba(255,255,255,0.015);
}

element-text,
element-icon {
  size: 26px;
  margin: 0 10 0 0;
  vertical-align: 0.5;
  text-color: inherit;
}

element-icon {
  size: 20px;
  text-color: @gruv8;
}

element.selected.normal element-icon,
element.selected.active element-icon,
element.selected.urgent element-icon {
  text-color: @gruv10;
}

button {
  padding:           6px 10px;
  color:             @foreground;
  horizontal-align:  0.5;
  border:            1px;
  border-color:      @gruv4;
  border-radius:     4px;
  background-color:  rgba(40,40,40,0.4);
  text-color:        @gruv9;
}

button.selected.normal {
  background-color: rgba(254,128,25,0.25);
  border-color: @accent;
  text-color: @gruv10;
}

// Message area + prompt adjustments
message {
  padding: 6px 8px;
  border: 0px;
  background-color: transparent;
  text-color: @gruv8;
}

prompt {
  text-color: @aqua;
}

entry {
  text-color: @gruv10;
}

case-indicator {
  text-color: @gruv7;
}

scrollbar {
  border: 0px;
  background-color: rgba(255,255,255,0.05);
}

scrollbar-handle {
  background-color: @accent;
}

