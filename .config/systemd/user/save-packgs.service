[Unit]
Description=Pushes pacman/aur packages installed to remote
Wants=network-online.target
After=network-online.target
ConditionPathExists=/var/log/pacman.log

[Service]
Type=oneshot
Environment=HOME=%h
Environment=PATH=/usr/bin:/bin
# Prevent overlapping runs
RuntimeDirectory=save-packgs
ExecStart=/usr/bin/flock -n %t/save-packgs/save-packgs.lock %h/.config/scripts/push_if_new_installed.sh
StandardOutput=journal
StandardError=journal
# Light hardening
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=full
ProtectControlGroups=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
LockPersonality=yes